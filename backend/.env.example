# Backend environment variables
# Copy this file to backend/.env and fill the values.

# LLM provider key (required for live model calls)
GROQ_API_KEY=your_groq_api_key_here

# TigerGraph credentials
TIGERGRAPH_HOST=tigergraph
TIGERGRAPH_PORT=443
TIGERGRAPH_GRAPH=FinancialCrimeGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph

# OpenAI fallback (optional)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_INFERENCE_MODEL=llama-3.1-8b-instant

# Pipeline model overrides
LLM_ONLY_MODEL=llama-3.3-70b-versatile
VECTOR_RAG_MODEL=llama-3.1-8b-instant
GRAPHRAG_MODEL=llama-3.1-8b-instant

# Feature toggles
GRAPHRAG_USE_LLM=false
HACKATHON_DEMO_MODE=true

# Frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
